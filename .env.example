# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet/application is hosted.
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
JWT_SECRET="xcloud-super-secure-production-jwt-secret-replace-me"
JWT_EXPIRATION="7d"

# DATABASE (PostgreSQL)
POSTGRES_DB="xcloud_production"
POSTGRES_USER="xcloud_admin"
POSTGRES_PASSWORD="secure_postgres_password_here"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://xcloud_admin:secure_postgres_password_here@postgres:5432/xcloud_production"

# REDIS & CELERY
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# FREERADIUS INTEGRATION
RADIUS_HOST="radius"
RADIUS_SECRET="xcloudRadiusSecretKey2026"
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_NAS_IDENTIFIER="xcloud-nas"

# WIREGUARD VPN MANAGEMENT
WG_SERVER_ENDPOINT="vpn.xcloud.tz"
WG_SERVER_PORT=51820
WG_SERVER_PUBLIC_KEY="public_key_generated_on_wireguard_host="
WG_SERVER_PRIVATE_KEY="private_key_generated_on_wireguard_host="
WG_SUBNET="10.88.0.0/16"

# TANZANIAN MOBILE MONEY GATEWAYS
# Vodacom M-Pesa (Daraja OpenAPI)
MPESA_API_KEY="your_mpesa_consumer_key"
MPESA_SECRET="your_mpesa_consumer_secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="your_mpesa_passkey"
MPESA_ENV="sandbox" # or production

# Airtel Money Tanzania
AIRTEL_API_KEY="your_airtel_client_id"
AIRTEL_SECRET="your_airtel_client_secret"
AIRTEL_COUNTRY="TZ"
AIRTEL_CURRENCY="TZS"

# Tigo Pesa Tanzania
TIGO_API_KEY="your_tigo_api_key"
TIGO_SECRET="your_tigo_secret"
TIGO_MERCHANT_PIN="1234"

# Selcom Pay
SELCOM_API_KEY="your_selcom_vendor_key"
SELCOM_SECRET="your_selcom_vendor_secret"

# SMS & NOTIFICATIONS (Beem SMS / Twilio)
SMS_PROVIDER="beem" # or twilio
BEEM_SMS_API_KEY="your_beem_api_key"
BEEM_SMS_SECRET_KEY="your_beem_secret_key"
BEEM_SENDER_ID="XCLOUD"

